# Copy to .env and edit. Every setting is optional; these are the defaults.

# ---- market ----
EXCHANGE=kraken                 # any ccxt id: kraken, coinbase, binance, binanceus, bitstamp, okx…
SYMBOLS=BTC/USD,ETH/USD         # markets to trade (use the exchange's spelling, e.g. BTC/USDT on binance)
TIMEFRAME=1h                    # 1m 5m 15m 30m 1h 4h 1d 1w
STRATEGY=trend                  # trend | meanrev | breakout
DATA_SOURCE=exchange            # exchange (real prices) | synthetic (offline practice)

# ---- mode ----
MODE=paper                      # paper (simulated fills on real prices) | live (real orders)
# Live trading also needs all of these:
# API_KEY=
# API_SECRET=
# API_PASSWORD=                 # only exchanges that use a passphrase (e.g. okx, kucoin)
# SANDBOX=true                  # true = exchange testnet; set false only when you mean it
# LIVE_CONFIRM=I accept the risk of losing money

# ---- money and costs ----
STARTING_CASH=10000             # paper account size
FEE_RATE=0.0026                 # per fill (0.26%); set to your exchange's taker fee
SLIPPAGE=0.0005                 # per fill (0.05%)

# ---- risk ----
RISK_PER_TRADE=0.01             # a stopped-out trade loses about 1% of equity
MAX_POSITION_FRACTION=0.25      # one position is at most 25% of equity
DAILY_LOSS_LIMIT=0.03           # no new trades after -3% in a day (UTC)
MAX_DRAWDOWN=0.15               # kill switch: no new trades after -15% from peak

POLL_SECONDS=60                 # how often to check prices and stops

# ---- Telegram (optional) ----
# TELEGRAM_TOKEN=123456:ABC…    # from @BotFather
# TELEGRAM_ALLOWED_USERS=       # your numeric Telegram ID(s); empty = first person to /start owns the bot

# ---- dashboard ----
WEB_HOST=127.0.0.1              # set 0.0.0.0 to reach it from other devices (then WEB_TOKEN is required)
WEB_PORT=8000
# WEB_TOKEN=pick-a-long-random-string

DB_PATH=tradebot.sqlite3
